{
  "name": "cloud-superbrain-developer-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "npm install --prefix apps/frontend && npm run build --prefix apps/frontend",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts\\verify-phase1.ps1",
    "verify:supply-chain-pins": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-supply-chain-pins.ps1",
    "verify:runtime": "powershell -ExecutionPolicy Bypass -File scripts\\verify-phase1-runtime.ps1",
    "verify:browser": "powershell -ExecutionPolicy Bypass -File scripts\\verify-browser-contract.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost && powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-product-acceptance.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost -ApproveLiveProviderCall && powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-22-page-actions.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost -ApproveLiveProviderCalls && node scripts\\verify-o4-live-write-browser.cjs --base-url http://localhost:8081 --allow-localhost && powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-o4-live-writes.ps1 -PromoteGateOnFullPass",
    "verify:22-page-actions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-22-page-actions.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost",
    "verify:product-acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-product-acceptance.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost -ApproveLiveProviderCall",
    "verify:tooling-readiness": "powershell -ExecutionPolicy Bypass -File scripts\\verify-tooling-readiness.ps1",
    "verify:cloud-provider-live-read": "powershell -ExecutionPolicy Bypass -File scripts\\verify-cloud-provider-live-read.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost -RequireT3ProviderSet",
    "verify:grafana-cloud-live-read-unit": "python scripts\\verify-grafana-cloud-live-read.py",
    "verify:phase6-frontend": "node scripts/verify-phase6-frontend.mjs",
    "verify:phase6-frontend:source": "node scripts/verify-phase6-frontend.mjs --source-only",
    "verify:csrf": "powershell -ExecutionPolicy Bypass -File scripts\\verify-phase3-csrf-origin-guard.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost",
    "verify:cross-origin": "powershell -ExecutionPolicy Bypass -File scripts\\verify-phase3-cross-origin-response-guard.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost",
    "verify:auth-session": "powershell -ExecutionPolicy Bypass -File scripts\\verify-phase3-auth-session-integrity.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost",
    "verify:oauth-boundary": "node --test apps/frontend/tests/oauth-boundary-readiness.test.mjs",
    "verify:memory-secret-guard": "powershell -ExecutionPolicy Bypass -File scripts\\verify-memory-worker-secret-guard.ps1",
    "verify:vector-memory-gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-vector-memory-gate.ps1",
    "verify:orchestrator-completion": "powershell -ExecutionPolicy Bypass -File scripts\\verify-orchestrator-completion-evidence.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost",
    "build:phase5-candidate-local": "powershell -ExecutionPolicy Bypass -File scripts\\build-phase5-production-candidate-local.ps1",
    "verify:phase5-candidate-local": "powershell -ExecutionPolicy Bypass -File scripts\\verify-phase5-production-candidate-local.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost",
    "verify:phase5-credit": "py -3 scripts\\verify_phase5_credit_itemization.py",
    "verify:phase6-scoreboard": "powershell -ExecutionPolicy Bypass -File scripts\\verify-phase6-local-scoreboard-performance-runtime.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost",
    "verify:phase6-scale:static": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-phase6-scale-runtime-static.ps1 && pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-phase6-scale-evidence-static.ps1",
    "verify:phase6-scale:evidence-static": "powershell -ExecutionPolicy Bypass -File scripts\\verify-phase6-scale-evidence-static.ps1",
    "verify:responsive": "node scripts/verify-workspace-responsive-browser.cjs --base-url http://localhost:8081 --allow-localhost",
    "verify:frontend-hosted-current": "powershell -ExecutionPolicy Bypass -File scripts\\verify-frontend-hosted-current.ps1 -SkipBrowser",
    "verify:backend-hosted-current": "powershell -ExecutionPolicy Bypass -File scripts\\verify-backend-hosted-current.ps1",
    "verify:cloudflare-llm-gateway": "powershell -ExecutionPolicy Bypass -File scripts\\verify-cloudflare-llm-gateway.ps1 -StaticOnly",
    "verify:cloudflare-stateful-runtime": "powershell -ExecutionPolicy Bypass -File scripts\\verify-cloudflare-stateful-runtime.ps1 -StaticOnly",
    "verify:cloudflare-stateful-runtime:local": "powershell -ExecutionPolicy Bypass -File scripts\\verify-cloudflare-stateful-runtime-local.ps1",
    "verify:stateful-build-browser": "node scripts/verify-stateful-build-browser.cjs",
    "verify:live-llm-evidence-chain": "powershell -ExecutionPolicy Bypass -File scripts\\verify-live-llm-evidence-chain.ps1",
    "verify:current-release-candidate": "powershell -ExecutionPolicy Bypass -File scripts\\verify.ps1 -Suite current-release-candidate -FailFast",
    "verify:market-ready": "powershell -ExecutionPolicy Bypass -File scripts\\verify-market-ready.ps1",
    "verify:market-ready:static": "powershell -ExecutionPolicy Bypass -File scripts\\verify-market-ready.ps1 -StaticOnly",
    "verify:market-ready:require-ready": "powershell -ExecutionPolicy Bypass -File scripts\\verify-market-ready.ps1 -IncludeExternalGates -RequireReady",
    "verify:hosted-local": "powershell -ExecutionPolicy Bypass -File scripts\\verify-hosted-staging.ps1 -BaseUrl http://localhost:8081 -AllowLocalhost",
    "verify:external-gates": "powershell -ExecutionPolicy Bypass -File scripts\\verify-external-gates.ps1",
    "verify:autopilot": "powershell -ExecutionPolicy Bypass -File scripts\\verify-autopilot-mode.ps1 -AllowLocalhost",
    "verify:autonomous-release-workflow": "powershell -ExecutionPolicy Bypass -File scripts\\verify-autonomous-release-workflow.ps1",
    "verify:release-boundary": "powershell -ExecutionPolicy Bypass -File scripts\\verify.ps1 -Suite release-boundary -FailFast",
    "verify:release-candidate": "powershell -ExecutionPolicy Bypass -File scripts\\verify.ps1 -Suite release-candidate -FailFast",
    "verify:release": "powershell -ExecutionPolicy Bypass -File scripts\\verify.ps1 -Suite release -FailFast",
    "verify:prepush": "powershell -ExecutionPolicy Bypass -File scripts\\run-autonomous-release-workflow.ps1",
    "verify:prepush:plan": "powershell -ExecutionPolicy Bypass -File scripts\\run-autonomous-release-workflow.ps1 -PlanOnly",
    "verify:prepush:dev": "powershell -ExecutionPolicy Bypass -File scripts\\run-autonomous-release-workflow.ps1 -AllowNonCandidateHead"
  }
}
