c","startedDateTime":"2026-06-14T19:55:20.401Z","time":9.649000000000001,"request":{"method":"GET","url":"http://localhost:8081/_next/static/chunks/app_app_styles_09puswe.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:8081"},{"name":"Referer","value":"http://localhost:8081/workbench"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/148.0.7778.96 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"148\", \"HeadlessChrome\";v=\"148\", \"Not/A)Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":566,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Cache-Control","value":"no-cache, must-revalidate"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Encoding","value":"gzip"},{"name":"Content-Type","value":"text/css; charset=UTF-8"},{"name":"Date","value":"Sun, 14 Jun 2026 19:55:20 GMT"},{"name":"ETag","value":"W/\"bd64-19ec7ad805c\""},{"name":"Last-Modified","value":"Sun, 14 Jun 2026 19:48:17 GMT"},{"name":"Server","value":"nginx/1.27.5"},{"name":"Transfer-Encoding","value":"chunked"},{"name":"Vary","value":"Accept-Encoding"}],"content":{"size":48484,"mimeType":"text/css; charset=UTF-8","compression":39302,"text":"/* [project]/app/app/styles.css [app-client] (css) */\n:root {\n  --bg-deep: #05070d;\n  --surface-1: #0b1020;\n  --surface-2: #101a31;\n  --surface-3: #121d37;\n  --glass: #0c1426c7;\n  --deep-navy: #001220;\n  --text-pri: #eaf2ff;\n  --text-mut: #8fa6c9;\n  --text-dim: #61759a;\n  --cyan: #00e5ff;\n  --blue: #3b82f6;\n  --violet: #8b5cf6;\n  --magenta: #ec4899;\n  --gold: #fbbf24;\n  --green: #22c55e;\n  --amber: #f59e0b;\n  --red: #ef4444;\n  --border: #367ecd47;\n  --border-hi: #00e5ff52;\n  --border-strong: #9acdff2e;\n  --r10: 10px;\n  --r14: 12px;\n  --r18: 14px;\n  --topbar-h: 64px;\n  --rail-w: 72px;\n  --sidebar-w: 240px;\n  --inspector-w: 300px;\n  --dock-h: 208px;\n  --gutter: 16px;\n  --font-ui: \"Inter\", \"Geist\", \"Sora\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --font-mono: \"JetBrains Mono\", \"Fira Code\", ui-monospace, monospace;\n  --lightningcss-light: ;\n  --lightningcss-dark: initial;\n  color-scheme: dark;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml, body {\n  height: 100%;\n}\n\nbody {\n  background: linear-gradient(180deg, #02050b 0%, #05070d 48%, #03050a 100%),\n    var(--bg-deep);\n  min-height: 100vh;\n  color: var(--text-pri);\n  font-family: var(--font-ui);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizelegibility;\n  margin: 0;\n}\n\nbody:before {\n  content: \"\";\n  pointer-events: none;\n  background-image: linear-gradient(#00e5ff09 1px, #0000 1px), linear-gradient(90deg, #00e5ff09 1px, #0000 1px);\n  background-size: 48px 48px;\n  position: fixed;\n  inset: 0;\n  -webkit-mask-image: linear-gradient(#000000b3, #0000002e);\n  mask-image: linear-gradient(#000000b3, #0000002e);\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\nbutton, input, textarea, select {\n  font: inherit;\n  color: inherit;\n}\n\nh1, h2, h3, h4, p {\n  margin: 0;\n}\n\n.mono {\n  font-family: var(--font-mono);\n}\n\n:where(a, button, input, textarea, select, [tabindex]):focus-visible {\n  outline: 2px solid var(--cyan);\n  outline-offset: 2px;\n  border-radius: 8px;\n}\n\n.app-shell {\n  grid-template-columns: var(--rail-w) 1fr;\n  grid-template-rows: var(--topbar-h) 1fr;\n  grid-template-areas: \"rail topbar\"\n                       \"rail main\";\n  min-height: 100vh;\n  display: grid;\n}\n\n.app-shell.marketing {\n  grid-template-columns: 1fr;\n  grid-template-areas: \"topbar\"\n                       \"main\";\n}\n\n.rail {\n  border-right: 1px solid var(--border);\n  background: linear-gradient(180deg, var(--surface-1), #0b102099);\n  flex-direction: column;\n  grid-area: rail;\n  align-items: center;\n  gap: 4px;\n  height: 100vh;\n  padding: 12px 0;\n  display: flex;\n  position: sticky;\n  top: 0;\n  overflow-y: auto;\n}\n\n.rail-logo {\n  background: linear-gradient(135deg, #00e5ff38, #3b82f685);\n  border: 1px solid #00e5ff47;\n  border-radius: 10px;\n  flex-shrink: 0;\n  place-items: center;\n  width: 40px;\n  height: 40px;\n  margin-bottom: 8px;\n  display: grid;\n  box-shadow: inset 0 1px #ffffff1f, 0 0 14px #3b82f638;\n}\n\n.rail-item {\n  width: 44px;\n  height: 40px;\n  color: var(--text-mut);\n  cursor: pointer;\n  background: none;\n  border: none;\n  border-radius: 10px;\n  flex-shrink: 0;\n  place-items: center;\n  transition: color .15s, background .15s;\n  display: grid;\n  position: relative;\n}\n\n.rail-item:hover {\n  color: var(--text-pri);\n  background: #ffffff0a;\n}\n\n.rail-item.active {\n  color: var(--cyan);\n  background: #00e5ff14;\n}\n\n.rail-item.active:before {\n  content: \"\";\n  background: var(--cyan);\n  width: 3px;\n  box-shadow: 0 0 8px var(--cyan);\n  border-radius: 0 3px 3px 0;\n  position: absolute;\n  top: 8px;\n  bottom: 8px;\n  left: -12px;\n}\n\n.rail-divider {\n  background: var(--border);\n  flex-shrink: 0;\n  width: 28px;\n  height: 1px;\n  margin: 6px 0;\n}\n\n.rail-spacer {\n  flex: 1;\n}\n\n.rail-tip {\n  background: var(--surface-2);\n  border: 1px solid var(--border);\n  color: var(--text-pri);\n  white-space: nowrap;\n  pointer-events: none;\n  opacity: 0;\n  z-index: 80;\n  border-radius: 7px;\n  padding: 4px 9px;\n  font-size: 12px;\n  transition: opacity .12s;\n  position: absolute;\n  top: 50%;\n  left: calc(100% + 8px);\n  transform: translateY(-50%);\n}\n\n.rail-item:hover .rail-tip {\n  opacity: 1;\n}\n\n.topbar {\n  border-bottom: 1px solid var(--border);\n  -webkit-backdrop-filter: blur(10px);\n  backdrop-filter: blur(10px);\n  z-index: 40;\n  background: #060c18db;\n  grid-area: topbar;\n  align-items: center;\n  gap: 12px;\n  padding: 0 18px;\n  display: flex;\n  position: sticky;\n  top: 0;\n}\n\n.topbar-chip {\n  border: 1px solid var(--border);\n  height: 32px;\n  color: var(--text-mut);\n  white-space: nowrap;\n  background: #ffffff06;\n  border-radius: 8px;\n  align-items: center;\n  gap: 7px;\n  padding: 0 10px;\n  font-size: 12px;\n  display: inline-flex;\n}\n\n.topbar-chip.safe {\n  color: #86efac;\n  background: #22c55e0f;\n  border-color: #22c55e47;\n}\n\n.crumb {\n  color: var(--text-mut);\n  font-size: 14px;\n}\n\n.crumb b {\n  color: var(--text-pri);\n  font-weight: 600;\n}\n\n.topbar .grow {\n  flex: 1;\n}\n\n.cmdk {\n  background: var(--surface-2);\n  border: 1px solid var(--border);\n  min-width: 240px;\n  max-width: 420px;\n  color: var(--text-mut);\n  border-radius: 10px;\n  flex: 1;\n  align-items: center;\n  gap: 8px;\n  padding: 7px 12px;\n  font-size: 13px;\n  display: flex;\n}\n\n.cmdk kbd {\n  font-family: var(--font-mono);\n  border: 1px solid var(--border);\n  background: #ffffff0f;\n  border-radius: 5px;\n  margin-left: auto;\n  padding: 1px 6px;\n  font-size: 11px;\n}\n\n.runpill {\n  border: 1px solid var(--border);\n  color: var(--text-pri);\n  border-radius: 8px;\n  align-items: center;\n  gap: 7px;\n  padding: 5px 11px;\n  font-size: 12px;\n  display: flex;\n}\n\n.verifypill {\n  white-space: nowrap;\n  border-radius: 999px;\n  align-items: center;\n  gap: 7px;\n  padding: 5px 11px;\n  font-size: 11.5px;\n  font-weight: 600;\n  display: flex;\n}\n\n.verifypill .vp-dot {\n  border-radius: 999px;\n  width: 7px;\n  height: 7px;\n}\n\n.verifypill.ok {\n  color: #34d399;\n  background: #10b9811f;\n  border: 1px solid #10b98166;\n}\n\n.verifypill.ok .vp-dot {\n  background: #34d399;\n  box-shadow: 0 0 7px #34d399e6;\n}\n\n.verifypill.spec {\n  color: #fbbf24;\n  background: #f59e0b1a;\n  border: 1px solid #f59e0b59;\n}\n\n.verifypill.spec .vp-dot {\n  background: #fbbf24;\n}\n\n@media (max-width: 1100px) {\n  .verifypill {\n    display: none;\n  }\n}\n\n.avatar {\n  color: #fff;\n  background: radial-gradient(circle at 30% 30%, var(--violet), var(--blue));\n  border-radius: 50%;\n  place-items: center;\n  width: 32px;\n  height: 32px;\n  font-size: 12px;\n  font-weight: 600;\n  display: grid;\n}\n\n.main {\n  min-width: 0;\n  padding: var(--gutter);\n  grid-area: main;\n  overflow-x: hidden;\n}\n\n.page {\n  width: min(1180px, 100%);\n  margin: 0 auto;\n}\n\n.page-wide {\n  width: 100%;\n}\n\n.page-head {\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 18px;\n  margin-bottom: 18px;\n  display: flex;\n}\n\n.page-head .eyebrow {\n  letter-spacing: .1em;\n  text-transform: uppercase;\n  color: var(--cyan);\n  margin-bottom: 6px;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.page-head h1 {\n  letter-spacing: -.01em;\n  font-size: 26px;\n  line-height: 1.15;\n}\n\n.page-head p {\n  color: var(--text-mut);\n  max-width: 70ch;\n  margin-top: 6px;\n  font-size: 14px;\n}\n\n.head-actions {\n  flex-wrap: wrap;\n  gap: 8px;\n  display: flex;\n}\n\n.panel {\n  border: 1px solid var(--border);\n  background: var(--surface-1);\n  border-radius: var(--r14);\n}\n\n.panel-pad {\n  padding: 16px;\n}\n\n.panel-head {\n  border-bottom: 1px solid var(--border);\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  padding: 13px 16px;\n  display: flex;\n}\n\n.panel-title {\n  letter-spacing: .04em;\n  text-transform: uppercase;\n  color: var(--text-mut);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.grid {\n  gap: var(--gutter);\n  display: grid;\n}\n\n.cols-2 {\n  grid-template-columns: repeat(2, 1fr);\n}\n\n.cols-3 {\n  grid-template-columns: repeat(3, 1fr);\n}\n\n.cols-4 {\n  grid-template-columns: repeat(4, 1fr);\n}\n\n.row {\n  gap: var(--gutter);\n  display: flex;\n}\n\n.stack {\n  gap: var(--gutter);\n  flex-direction: column;\n  display: flex;\n}\n\n.metric {\n  border: 1px solid var(--border);\n  background: var(--surface-1);\n  border-radius: var(--r14);\n  flex-direction: column;\n  gap: 8px;\n  min-height: 120px;\n  padding: 16px;\n  display: flex;\n}\n\n.metric .label {\n  color: var(--text-mut);\n  text-transform: uppercase;\n  letter-spacing: .05em;\n  font-size: 12px;\n}\n\n.metric .value {\n  letter-spacing: -.02em;\n  font-size: 28px;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.metric .foot {\n  color: var(--text-mut);\n  align-items: center;\n  gap: 8px;\n  margin-top: auto;\n  font-size: 12px;\n  display: flex;\n}\n\n.dot {\n  border-radius: 50%;\n  flex-shrink: 0;\n  width: 8px;\n  height: 8px;\n  display: inline-block;\n}\n\n.dot.pulse {\n  animation: 1.6s ease-in-out infinite pulse;\n}\n\n@keyframes pulse {\n  0%, 100% {\n    opacity: 1;\n    transform: scale(1);\n  }\n\n  50% {\n    opacity: .45;\n    transform: scale(.82);\n  }\n}\n\n.badge {\n  letter-spacing: .02em;\n  border: 1px solid var(--border);\n  height: 24px;\n  color: var(--text-mut);\n  white-space: nowrap;\n  background: #ffffff05;\n  border-radius: 7px;\n  align-items: center;\n  gap: 6px;\n  padding: 0 9px;\n  font-size: 11.5px;\n  font-weight: 500;\n  display: inline-flex;\n}\n\n.badge svg {\n  flex-shrink: 0;\n}\n\n.badge-cyan {\n  color: var(--cyan);\n  border-color: var(--border-hi);\n  background: #00e5ff14;\n}\n\n.badge-green {\n  color: #86efac;\n  background: #22c55e1a;\n  border-color: #22c55e66;\n}\n\n.badge-amber {\n  color: #fcd34d;\n  background: #f59e0b1a;\n  border-color: #f59e0b66;\n}\n\n.badge-red {\n  color: #fca5a5;\n  background: #ef44441a;\n  border-color: #ef444466;\n}\n\n.badge-violet {\n  color: #c4b5fd;\n  background: #8b5cf61a;\n  border-color: #8b5cf666;\n}\n\n.badge-mut {\n  color: var(--text-mut);\n}\n\n.btn {\n  border: 1px solid var(--border);\n  background: var(--surface-2);\n  color: var(--text-pri);\n  cursor: pointer;\n  border-radius: 8px;\n  align-items: center;\n  gap: 8px;\n  padding: 9px 15px;\n  font-size: 13.5px;\n  font-weight: 500;\n  transition: border-color .15s, background .15s, transform 50ms;\n  display: inline-flex;\n}\n\n.btn:hover {\n  border-color: var(--border-strong);\n}\n\n.btn:active {\n  transform: translateY(1px);\n}\n\n.btn-primary {\n  background: linear-gradient(180deg, var(--blue), #2563eb);\n  color: #fff;\n  border-color: #0000;\n  box-shadow: 0 4px 16px #3b82f64d;\n}\n\n.btn-primary:hover {\n  box-shadow: 0 6px 20px #3b82f66b;\n}\n\n.btn-ghost {\n  background: none;\n}\n\n.btn-danger {\n  color: #fca5a5;\n  background: #ef44441f;\n  border-color: #ef444466;\n}\n\n.btn[disabled], .btn.disabled {\n  opacity: .5;\n  cursor: not-allowed;\n}\n\n.btn-sm {\n  padding: 6px 11px;\n  font-size: 12.5px;\n}\n\n.chips {\n  flex-wrap: wrap;\n  gap: 6px;\n  display: flex;\n}\n\n.chip {\n  border: 1px solid var(--border);\n  color: var(--text-mut);\n  cursor: pointer;\n  background: none;\n  border-radius: 7px;\n  padding: 6px 11px;\n  font-size: 12.5px;\n}\n\n.chip.active {\n  color: var(--cyan);\n  border-color: var(--border-hi);\n  background: #00e5ff14;\n}\n\n.list {\n  flex-direction: column;\n  display: flex;\n}\n\n.lrow {\n  border-bottom: 1px solid var(--border);\n  align-items: center;\n  gap: 12px;\n  padding: 11px 14px;\n  font-size: 13.5px;\n  display: flex;\n}\n\n.lrow:last-child {\n  border-bottom: none;\n}\n\n.lrow:hover {\n  background: #ffffff05;\n}\n\n.lrow .meta {\n  color: var(--text-mut);\n  margin-left: auto;\n  font-size: 12px;\n}\n\n.empty {\n  border: 1px dashed var(--border-strong);\n  border-radius: var(--r14);\n  text-align: center;\n  color: var(--text-mut);\n  padding: 32px 24px;\n}\n\n.empty h3 {\n  color: var(--text-pri);\n  margin-bottom: 6px;\n  font-size: 15px;\n}\n\n.empty p {\n  max-width: 44ch;\n  margin: 0 auto 14px;\n  font-size: 13px;\n}\n\n.skeleton {\n  background: linear-gradient(90deg, #ffffff0a, #ffffff17, #ffffff0a) 0 0 / 200% 100%;\n  border-radius: 8px;\n  animation: 1.4s linear infinite shimmer;\n}\n\n@keyframes shimmer {\n  0% {\n    background-position: 200% 0;\n  }\n\n  100% {\n    background-position: -200% 0;\n  }\n}\n\n.safety-row {\n  flex-wrap: wrap;\n  gap: 8px;\n  display: flex;\n}\n\n.tbl {\n  border-collapse: collapse;\n  width: 100%;\n  font-size: 13px;\n}\n\n.tbl th {\n  text-align: left;\n  color: var(--text-mut);\n  text-transform: uppercase;\n  letter-spacing: .05em;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface-1);\n  padding: 10px 14px;\n  font-size: 11.5px;\n  font-weight: 500;\n  position: sticky;\n  top: 0;\n}\n\n.tbl td {\n  border-bottom: 1px solid var(--border);\n  padding: 11px 14px;\n}\n\n.tbl tr:hover td {\n  background: #ffffff05;\n}\n\n.tree {\n  font-size: 13px;\n}\n\n.tnode {\n  color: var(--text-mut);\n  cursor: pointer;\n  border-radius: 6px;\n  align-items: center;\n  gap: 7px;\n  padding: 4px 8px;\n  display: flex;\n}\n\n.tnode:hover {\n  background: #ffffff0a;\n}\n\n.tnode.sel {\n  color: var(--text-pri);\n  background: #00e5ff1a;\n}\n\n.bar {\n  background: #ffffff12;\n  border-radius: 999px;\n  height: 6px;\n  overflow: hidden;\n}\n\n.bar > span {\n  background: linear-gradient(90deg, var(--cyan), var(--blue));\n  border-radius: 999px;\n  height: 100%;\n  display: block;\n}\n\n.code {\n  font-family: var(--font-mono);\n  border: 1px solid var(--border);\n  white-space: pre;\n  color: #cfe3ff;\n  background: #04060c;\n  border-radius: 10px;\n  padding: 14px 16px;\n  font-size: 12.5px;\n  line-height: 20px;\n  overflow: auto;\n}\n\n.k {\n  color: var(--magenta);\n}\n\n.fn {\n  color: var(--cyan);\n}\n\n.s {\n  color: var(--green);\n}\n\n.n {\n  color: var(--amber);\n}\n\n.cmt {\n  color: var(--text-dim);\n}\n\n.cortex-wrap {\n  border-radius: var(--r14);\n  border: 1px solid var(--border);\n  background: radial-gradient(60% 60% at 50% 42%, #0b102033, #04060c 78%);\n  height: 100%;\n  position: relative;\n  overflow: hidden;\n}\n\n.cortex-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n  position: absolute;\n  inset: 0;\n}\n\n.cortex3d-label {\n  color: var(--text-pri);\n  white-space: nowrap;\n  background: #0b1020eb;\n  border: 1px solid #00e5ff73;\n  border-radius: 6px;\n  padding: 3px 9px;\n  font-size: 11px;\n  font-weight: 600;\n  transform: translateY(-30px);\n  box-shadow: 0 4px 16px #00000080;\n}\n\n.hub3d-label {\n  letter-spacing: .09em;\n  text-transform: uppercase;\n  color: var(--text-mut);\n  white-space: nowrap;\n  -webkit-backdrop-filter: blur(4px);\n  backdrop-filter: blur(4px);\n  background: #05070da8;\n  border: 1px solid #ffffff1a;\n  border-radius: 6px;\n  padding: 3px 8px;\n  font-size: 9.5px;\n  font-weight: 700;\n  transition: color .2s, border-color .2s, box-shadow .2s;\n}\n\n.hub3d-label.active {\n  color: var(--text-pri);\n  border-color: #00e5ff8c;\n  box-shadow: 0 0 16px #00e5ff4d;\n}\n\n.org-hud {\n  color: var(--text-mut);\n  border: 1px solid var(--border);\n  -webkit-backdrop-filter: blur(4px);\n  backdrop-filter: blur(4px);\n  pointer-events: none;\n  background: #05070d9e;\n  border-radius: 7px;\n  gap: 10px;\n  padding: 5px 10px;\n  font-size: 10.5px;\n  display: flex;\n  position: absolute;\n  bottom: 12px;\n  left: 12px;\n}\n\n.org-feed {\n  letter-spacing: .04em;\n  white-space: nowrap;\n  border-radius: 999px;\n  padding: 1px 8px;\n  font-weight: 700;\n}\n\n.org-feed.live {\n  color: #34d399;\n  background: #10b98124;\n  border: 1px solid #10b98173;\n}\n\n.org-feed.spec {\n  color: #fbbf24;\n  background: #f59e0b1f;\n  border: 1px solid #f59e0b66;\n}\n\n.lg-pip {\n  background: #34d399;\n  border-radius: 999px;\n  width: 7px;\n  height: 7px;\n  box-shadow: 0 0 7px #34d399e6;\n}\n\n.cap-badge {\n  color: var(--text-mut);\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  align-items: center;\n  gap: 7px;\n  padding: 3px 10px;\n  font-size: 11px;\n  font-weight: 600;\n  display: inline-flex;\n}\n\n.cap-dot {\n  background: var(--text-dim);\n  border-radius: 999px;\n  width: 7px;\n  height: 7px;\n}\n\n.cap-dot.gpu {\n  background: #a855f7;\n  box-shadow: 0 0 7px #a855f7e6;\n}\n\n.cap-dot.ok {\n  background: #34d399;\n  box-shadow: 0 0 7px #34d399d9;\n}\n\n.cap-dot.soft {\n  background: var(--amber);\n}\n\n.state-btn:disabled {\n  opacity: .4;\n  cursor: not-allowed;\n}\n\n.org-gates {\n  pointer-events: none;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 5px;\n  max-width: 55%;\n  display: flex;\n  position: absolute;\n  bottom: 12px;\n  right: 12px;\n}\n\n.org-gate {\n  letter-spacing: .03em;\n  color: #f87171;\n  white-space: nowrap;\n  background: #ef44441a;\n  border: 1px solid #ef444459;\n  border-radius: 999px;\n  padding: 2px 8px;\n  font-size: 9.5px;\n  font-weight: 600;\n}\n\n.filter-chip {\n  border: 1px solid var(--border);\n  background: var(--surface-2);\n  color: var(--text-dim);\n  cursor: pointer;\n  border-radius: 7px;\n  padding: 3px 9px;\n  font-size: 10.5px;\n  font-weight: 600;\n  transition: opacity .15s, border-color .15s, color .15s;\n}\n\n.filter-chip:not(.on) {\n  opacity: .42;\n}\n\n.filter-chip.on {\n  color: var(--text-pri);\n}\n\n.cortex-badge {\n  letter-spacing: .06em;\n  color: var(--cyan);\n  border: 1px solid var(--border-hi);\n  background: #00000080;\n  border-radius: 7px;\n  padding: 4px 9px;\n  font-size: 10px;\n  position: absolute;\n  top: 12px;\n  left: 12px;\n}\n\n.cortex-state {\n  letter-spacing: .05em;\n  color: var(--text-pri);\n  border: 1px solid var(--border);\n  background: #00000080;\n  border-radius: 7px;\n  align-items: center;\n  gap: 7px;\n  padding: 4px 9px;\n  font-size: 10.5px;\n  display: flex;\n  position: absolute;\n  top: 12px;\n  right: 12px;\n}\n\n.cortex-fallback {\n  text-align: center;\n  color: var(--text-mut);\n  place-items: center;\n  height: 100%;\n  padding: 24px;\n  font-size: 13px;\n  display: grid;\n}\n\n.legend {\n  flex-direction: column;\n  display: flex;\n}\n\n.lg-row {\n  cursor: pointer;\n  color: var(--text-mut);\n  text-align: left;\n  background: none;\n  border: 1px solid #0000;\n  border-radius: 8px;\n  align-items: center;\n  gap: 9px;\n  width: 100%;\n  padding: 8px 12px;\n  font-size: 12.5px;\n  display: flex;\n}\n\n.lg-row:hover {\n  color: var(--text-pri);\n  background: #ffffff08;\n}\n\n.lg-row.active {\n  border-color: var(--border-hi);\n  color: var(--text-pri);\n  background: #00e5ff12;\n}\n\n.lg-dot {\n  border-radius: 50%;\n  flex-shrink: 0;\n  width: 9px;\n  height: 9px;\n}\n\n.lg-cap {\n  color: var(--text-dim);\n}\n\n.organism-runtime-feed {\n  overflow: hidden;\n}\n\n.runtime-meta {\n  color: var(--text-dim);\n  flex-wrap: wrap;\n  gap: 6px;\n  padding: 0 12px 10px;\n  font-size: 10.5px;\n  display: flex;\n}\n\n.runtime-list {\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  gap: 1px;\n  display: grid;\n}\n\n.runtime-event-row {\n  background: #ffffff05;\n  grid-template-columns: 10px 1fr;\n  gap: 8px;\n  padding: 8px 12px;\n  display: grid;\n}\n\n.runtime-event-dot {\n  background: var(--cyan);\n  border-radius: 50%;\n  width: 7px;\n  height: 7px;\n  margin-top: 5px;\n  box-shadow: 0 0 8px #00e5ffbf;\n}\n\n.runtime-event-title, .runtime-event-meta, .runtime-frame-row, .runtime-guard {\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n  display: flex;\n}\n\n.runtime-event-title {\n  color: var(--text-pri);\n  font-size: 12.5px;\n}\n\n.runtime-event-title span:first-child {\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n  overflow: hidden;\n}\n\n.runtime-event-meta {\n  color: var(--text-dim);\n  margin-top: 3px;\n  font-size: 10.5px;\n}\n\n.runtime-empty {\n  color: var(--text-dim);\n  padding: 10px 12px;\n  font-size: 12px;\n}\n\n.runtime-frames {\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  gap: 1px;\n  margin: 10px 12px 0;\n  display: grid;\n  overflow: hidden;\n}\n\n.runtime-frame-row {\n  color: var(--text-mut);\n  background: #00e5ff09;\n  padding: 6px 8px;\n  font-size: 11px;\n}\n\n.runtime-frame-row span:nth-child(2) {\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n  overflow: hidden;\n}\n\n.runtime-guard {\n  color: var(--text-dim);\n  padding: 9px 12px 11px;\n  font-size: 10.5px;\n}\n\n.state-row {\n  flex-wrap: wrap;\n  gap: 6px;\n  display: flex;\n}\n\n.state-btn {\n  border: 1px solid var(--border);\n  background: var(--surface-1);\n  color: var(--text-mut);\n  cursor: pointer;\n  border-radius: 9px;\n  padding: 7px 13px;\n  font-size: 12.5px;\n}\n\n.state-btn.active {\n  color: var(--text-pri);\n  border-color: var(--border-hi);\n  background: #00e5ff0f;\n}\n\n.hero {\n  grid-template-columns: 1.1fr .9fr;\n  align-items: center;\n  gap: 28px;\n  padding: 28px 0 8px;\n  display: grid;\n}\n\n.hero h1 {\n  letter-spacing: -.025em;\n  background: linear-gradient(110deg, var(--text-pri) 30%, var(--cyan));\n  -webkit-text-fill-color: transparent;\n  -webkit-background-clip: text;\n  background-clip: text;\n  font-size: 44px;\n  line-height: 1.05;\n}\n\n.hero p {\n  color: var(--text-mut);\n  max-width: 52ch;\n  margin-top: 16px;\n  font-size: 16px;\n}\n\n.hero-cta {\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 24px;\n  display: flex;\n}\n\n.hero-canvas {\n  aspect-ratio: 1;\n}\n\n.hero-stats {\n  grid-template-columns: repeat(4, 1fr);\n  gap: 12px;\n  margin-top: 30px;\n  display: grid;\n}\n\n.stat {\n  border: 1px solid var(--border);\n  border-radius: var(--r14);\n  background: var(--surface-1);\n  padding: 16px;\n}\n\n.stat .v {\n  font-size: 24px;\n  font-weight: 700;\n}\n\n.stat .l {\n  color: var(--text-mut);\n  margin-top: 4px;\n  font-size: 12px;\n}\n\n.home-hero-shell {\n  grid-template-columns: minmax(0, 1fr) minmax(320px, .8fr);\n  align-items: stretch;\n  gap: 18px;\n  margin-bottom: 16px;\n  display: grid;\n}\n\n.home-hero-copy {\n  align-content: start;\n  gap: 12px;\n  min-width: 0;\n  display: grid;\n}\n\n.home-cortex-card {\n  border: 1px solid var(--border-hi);\n  background: linear-gradient(180deg, #00e5ff14, #3b82f606),\n    var(--surface-1);\n  border-radius: 12px;\n  min-height: 360px;\n  overflow: hidden;\n  box-shadow: 0 0 0 1px #00e5ff0d, 0 24px 70px #00000038;\n}\n\n.home-cortex-card .cortex-wrap {\n  background: radial-gradient(circle at 50% 46%, #00e5ff24, #05070d38 48%, #0000 70%);\n  border: 0;\n  border-radius: 0;\n  min-height: 306px;\n}\n\n.home-cortex-canvas {\n  height: 306px;\n}\n\n.home-cortex-footer {\n  border-top: 1px solid var(--border);\n  background: #05070d70;\n  flex-wrap: wrap;\n  gap: 8px;\n  padding: 10px 12px 12px;\n  display: flex;\n}\n\n.feature-grid {\n  grid-template-columns: repeat(4, 1fr);\n  gap: 14px;\n  margin-top: 28px;\n  display: grid;\n}\n\n.feature {\n  border: 1px solid var(--border);\n  border-radius: var(--r14);\n  background: var(--surface-1);\n  padding: 18px;\n}\n\n.feature .ico {\n  width: 36px;\n  height: 36px;\n  color: var(--cyan);\n  background: #00e5ff1a;\n  border-radius: 10px;\n  place-items: center;\n  margin-bottom: 12px;\n  display: grid;\n}\n\n.feature h3 {\n  margin-bottom: 6px;\n  font-size: 15px;\n}\n\n.feature p {\n  color: var(--text-mut);\n  font-size: 13px;\n}\n\n.marketing-topbar {\n  align-items: center;\n  gap: 16px;\n  padding: 0 28px;\n  display: flex;\n}\n\n.brandmark {\n  align-items: center;\n  gap: 10px;\n  font-size: 15px;\n  font-weight: 600;\n  display: flex;\n}\n\n.brandmark .glyph {\n  background: radial-gradient(circle at 30% 28%, var(--violet), var(--blue));\n  border-radius: 9px;\n  width: 30px;\n  height: 30px;\n  box-shadow: 0 0 14px #8b5cf673;\n}\n\n.marketing-nav {\n  gap: 18px;\n  margin-left: 20px;\n  display: flex;\n}\n\n.marketing-nav a {\n  color: var(--text-mut);\n  font-size: 13.5px;\n}\n\n.marketing-nav a:hover {\n  color: var(--text-pri);\n}\n\n.footer-slogan {\n  border-top: 1px solid var(--border);\n  letter-spacing: .06em;\n  text-transform: uppercase;\n  color: var(--text-mut);\n  flex-wrap: wrap;\n  gap: 22px;\n  margin-top: 40px;\n  padding: 22px 0;\n  font-size: 12.5px;\n  display: flex;\n}\n\n.layer-strip {\n  flex-direction: column;\n  gap: 6px;\n  display: flex;\n}\n\n.layer-row {\n  border: 1px solid var(--border);\n  background: var(--surface-1);\n  border-radius: 10px;\n  grid-template-columns: 40px minmax(150px, .85fr) 1.4fr;\n  align-items: center;\n  gap: 12px;\n  padding: 9px 12px;\n  display: grid;\n}\n\n.layer-tag {\n  font-family: var(--font-mono);\n  text-align: center;\n  color: #04060c;\n  border-radius: 7px;\n  padding: 4px 0;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.layer-name {\n  color: var(--text-pri);\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.layer-providers {\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 6px;\n  display: flex;\n}\n\n.layer-chip {\n  white-space: nowrap;\n  background: #04060c8c;\n  border: 1px solid;\n  border-radius: 999px;\n  padding: 2px 9px;\n  font-size: 11px;\n  font-weight: 600;\n}\n\n@media (max-width: 640px) {\n  .layer-row {\n    grid-template-columns: 36px 1fr;\n  }\n\n  .layer-providers {\n    grid-column: 1 / -1;\n    justify-content: flex-start;\n  }\n\n  .frames, .readiness {\n    grid-template-columns: 1fr;\n  }\n}\n\n.stack-list {\n  flex-direction: column;\n  display: flex;\n}\n\n.layer-row-flat {\n  border: none;\n  border-bottom: 1px solid var(--border);\n  background: none;\n  border-radius: 0;\n}\n\n.layer-row-flat:last-child {\n  border-bottom: none;\n}\n\n.prov-card {\n  border: 1px solid var(--border);\n  border-radius: var(--r14);\n  background: var(--surface-1);\n  flex-direction: column;\n  gap: 8px;\n  padding: 14px;\n  display: flex;\n}\n\n.prov-head {\n  align-items: center;\n  gap: 8px;\n  display: flex;\n}\n\n.prov-head h3 {\n  flex: 1;\n  margin: 0;\n  font-size: 14px;\n}\n\n.prov-dot {\n  border-radius: 3px;\n  flex: none;\n  width: 10px;\n  height: 10px;\n}\n\n.prov-role {\n  color: var(--text-mut);\n  min-height: 34px;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.prov-layers {\n  flex-wrap: wrap;\n  gap: 5px;\n  display: flex;\n}\n\n.prov-layer {\n  font-family: var(--font-mono);\n  border: 1px solid;\n  border-radius: 6px;\n  padding: 1px 7px;\n  font-size: 10.5px;\n  font-weight: 600;\n}\n\n.prov-api {\n  color: var(--text-dim);\n  margin-top: auto;\n  font-size: 11px;\n}\n\n.inspect-label {\n  color: var(--text-dim);\n  text-transform: uppercase;\n  letter-spacing: .05em;\n  margin-top: 12px;\n  font-size: 10.5px;\n}\n\n.agent-head {\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 6px;\n  display: flex;\n}\n\n.agent-type {\n  text-transform: capitalize;\n  color: var(--text-pri);\n  font-size: 15px;\n  font-weight: 700;\n}\n\n.agent-role {\n  color: var(--text-mut);\n  font-size: 12.5px;\n  line-height: 1.5;\n}\n\n.agent-model {\n  color: #00e5ff;\n  margin-top: 3px;\n  font-size: 12.5px;\n}\n\n.agent-fallbacks {\n  color: var(--text-dim);\n  margin-top: 2px;\n  font-size: 11.5px;\n}\n\n.chip-wrap {\n  flex-wrap: wrap;\n  gap: 5px;\n  margin-top: 4px;\n  display: flex;\n}\n\n.tool-chip {\n  color: var(--text-pri);\n  background: #00e5ff14;\n  border: 1px solid #00e5ff47;\n  border-radius: 6px;\n  padding: 2px 8px;\n  font-size: 11px;\n}\n\n.review-chip {\n  color: #f59e0b;\n  background: #f59e0b1a;\n  border: 1px solid #f59e0b52;\n  border-radius: 6px;\n  padding: 2px 8px;\n  font-size: 11px;\n}\n\n.svc-row {\n  align-items: center;\n  gap: 10px;\n  display: flex;\n}\n\n.svc-meta {\n  color: var(--text-dim);\n  margin-left: auto;\n  font-size: 11.5px;\n}\n\n.surface-row {\n  border-bottom: 1px solid var(--border);\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  padding: 5px 0;\n  display: flex;\n}\n\n.surface-row:last-child {\n  border-bottom: none;\n}\n\n.wb {\n  grid-template-columns: var(--sidebar-w) 1fr var(--inspector-w);\n  gap: var(--gutter);\n  min-height: 420px;\n  display: grid;\n}\n\n.wb-dock {\n  gap: var(--gutter);\n  height: var(--dock-h);\n  margin-top: var(--gutter);\n  grid-template-columns: 1fr 320px 1fr;\n  display: grid;\n}\n\n.wb-pad {\n  padding: 14px;\n  overflow: auto;\n}\n\n.steps {\n  flex-direction: column;\n  gap: 10px;\n  display: flex;\n}\n\n.step {\n  color: var(--text-mut);\n  align-items: center;\n  gap: 9px;\n  font-size: 13px;\n  display: flex;\n}\n\n.step.done {\n  color: var(--text-pri);\n}\n\n.step.active {\n  color: var(--cyan);\n}\n\n.workbench-blueprint {\n  --studio-border: #367ecd5c;\n  flex-direction: column;\n  gap: 12px;\n  display: flex;\n}\n\n.industrial-toolbar {\n  border: 1px solid var(--studio-border);\n  background: linear-gradient(#0a1427eb, #040912f5);\n  border-radius: 12px;\n  align-items: center;\n  gap: 10px;\n  min-height: 56px;\n  padding: 10px 12px;\n  display: flex;\n  box-shadow: inset 0 1px #ffffff0d;\n}\n\n.tool-select, .tool-env {\n  border: 1px solid var(--border);\n  min-height: 38px;\n  color: var(--text-pri);\n  background: #ffffff06;\n  border-radius: 8px;\n  align-items: center;\n  gap: 9px;\n  padding: 0 12px;\n  font-size: 13px;\n  display: inline-flex;\n}\n\n.tool-select:first-child {\n  min-width: 260px;\n}\n\n.tool-env {\n  flex-direction: row;\n  margin-left: auto;\n}\n\n.tool-env small {\n  color: var(--text-dim);\n  margin-left: 2px;\n  font-size: 11px;\n}\n\n.tool-gate-note {\n  color: var(--text-dim);\n  background: #071121a6;\n  border: 1px solid #94a3b833;\n  border-radius: 8px;\n  padding: 7px 9px;\n  font-size: 11px;\n}\n\n.tool-actions {\n  gap: 6px;\n  display: flex;\n}\n\n.icon-btn {\n  border: 1px solid var(--border);\n  width: 38px;\n  height: 38px;\n  color: var(--text-mut);\n  cursor: pointer;\n  background: #ffffff06;\n  border-radius: 8px;\n  place-items: center;\n  display: inline-grid;\n}\n\n.icon-btn:hover {\n  color: var(--text-pri);\n  border-color: var(--border-strong);\n  background: #ffffff0b;\n}\n\n.icon-btn:disabled, .icon-btn[aria-disabled=\"true\"] {\n  cursor: not-allowed;\n  color: var(--text-dim);\n  opacity: .64;\n  background: #ffffff03;\n  border-color: #9acdff1f;\n}\n\n.icon-btn:disabled:hover, .icon-btn[aria-disabled=\"true\"]:hover {\n  color: var(--text-dim);\n  background: #ffffff03;\n  border-color: #9acdff1f;\n}\n\n.icon-btn.flat {\n  background: none;\n  width: 28px;\n  height: 28px;\n}\n\n.icon-btn.send {\n  color: var(--cyan);\n  border-color: #00e5ff4d;\n}\n\n.team-stack {\n  align-items: center;\n  padding-left: 4px;\n  display: flex;\n}\n\n.team-avatar {\n  color: #eaf2ff;\n  background: linear-gradient(135deg, #12213b, #1d4ed8);\n  border: 1px solid #9acdff4d;\n  border-radius: 50%;\n  place-items: center;\n  width: 30px;\n  height: 30px;\n  margin-left: -5px;\n  font-size: 10px;\n  font-weight: 700;\n  display: grid;\n}\n\n.team-avatar.muted {\n  color: var(--text-mut);\n  background: #071121;\n}\n\n.wb-studio {\n  grid-template-columns: 260px minmax(420px, 1fr) minmax(360px, 42%);\n  gap: 12px;\n  min-height: 520px;\n  display: grid;\n}\n\n.wb-pane {\n  border: 1px solid var(--studio-border);\n  background: linear-gradient(#081121f0, #030810f7);\n  border-radius: 12px;\n  min-width: 0;\n  overflow: hidden;\n  box-shadow: inset 0 1px #ffffff0b;\n}\n\n.wb-pane-head {\n  height: 42px;\n  color: var(--text-pri);\n  border-bottom: 1px solid #367ecd38;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  padding: 0 13px;\n  font-size: 13px;\n  font-weight: 600;\n  display: flex;\n}\n\n.wb-tree {\n  color: var(--text-mut);\n  padding: 12px;\n  font-size: 13px;\n}\n\n.tree-root, .tree-folder, .tree-file {\n  border-radius: 6px;\n  align-items: center;\n  gap: 8px;\n  min-height: 26px;\n  padding: 2px 8px;\n  display: flex;\n}\n\n.wb-file-button {\n  width: 100%;\n  color: inherit;\n  font: inherit;\n  text-align: left;\n  cursor: pointer;\n  background: none;\n  border: 0;\n}\n\n.wb-file-button:hover {\n  color: var(--text-pri);\n  background: #3b82f61c;\n}\n\n.tree-root {\n  color: var(--text-pri);\n  font-weight: 600;\n}\n\n.tree-folder {\n  color: #c7d7ef;\n  margin-top: 8px;\n}\n\n.tree-folder:before {\n  content: \"▾\";\n  color: var(--text-dim);\n}\n\n.tree-file.selected {\n  color: #dbeafe;\n  background: #3b82f638;\n  border: 1px solid #3b82f647;\n}\n\n.session-strip {\n  border: 1px solid var(--border);\n  color: var(--text-mut);\n  border-radius: 8px;\n  justify-content: space-between;\n  gap: 8px;\n  margin: 12px;\n  padding: 10px;\n  font-size: 12px;\n  display: flex;\n}\n\n.industrial-code {\n  color: #cfe3ff;\n  height: calc(100% - 42px);\n  font-family: var(--font-mono);\n  white-space: pre-wrap;\n  background: linear-gradient(90deg, #9acdff14 1px, #0000 1px) 0 0 / 48px 100%, #030711;\n  margin: 0;\n  padding: 28px 34px;\n  font-size: 17px;\n  line-height: 34px;\n  overflow: auto;\n}\n\n.muted-copy {\n  color: var(--text-dim);\n}\n\n.preview-tabs {\n  border-bottom: 1px solid #367ecd33;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  display: grid;\n}\n\n.preview-tabs button {\n  appearance: none;\n  text-align: center;\n  color: var(--text-mut);\n  font-size: 12px;\n  font: inherit;\n  cursor: not-allowed;\n  background: none;\n  border: 0;\n  border-right: 1px solid #367ecd29;\n  padding: 10px 8px;\n}\n\n.preview-tabs button.active {\n  color: var(--text-pri);\n  box-shadow: inset 0 -2px var(--blue);\n  background: #3b82f61a;\n}\n\n.game-preview {\n  background: linear-gradient(90deg, #9acdff0f 1px, #0000 1px) 0 0 / 44px 100%, linear-gradient(0deg, #9acdff0d 1px, #0000 1px) 0 0 / 100% 38px, linear-gradient(140deg, #3b82f62e, #07112114 44%, #14d8c81a), #050a13;\n  border: 1px solid #9acdff2e;\n  border-radius: 9px;\n  height: 300px;\n  margin: 12px;\n  position: relative;\n  overflow: hidden;\n}\n\n.preview-sky {\n  opacity: .72;\n  background: linear-gradient(115deg, #0000 35%, #9acdff1f 36%, #0000 38%), linear-gradient(150deg, #0000 55%, #14d8c814 56%, #0000 58%);\n  position: absolute;\n  inset: 0;\n}\n\n.preview-world {\n  position: absolute;\n  inset: 0;\n}\n\n.terrain {\n  clip-path: polygon(0 52%, 18% 40%, 36% 54%, 54% 36%, 72% 50%, 100% 34%, 100% 100%, 0 100%);\n  background: linear-gradient(90deg, #9acdff1f 1px, #0000 1px) 0 0 / 56px 100%, linear-gradient(0deg, #9acdff1a 1px, #0000 1px) 0 0 / 100% 24px, linear-gradient(165deg, #101a31eb, #080e1af5);\n  height: 112px;\n  position: absolute;\n  bottom: -18px;\n  left: -8%;\n  right: -8%;\n}\n\n.avatar-stand {\n  clip-path: polygon(28% 0, 72% 0, 86% 26%, 76% 100%, 24% 100%, 14% 26%);\n  background: linear-gradient(#eaf2ffdb, #3b82f647 42%, #0f172af0);\n  border: 1px solid #9acdff47;\n  border-radius: 4px;\n  width: 46px;\n  height: 84px;\n  position: absolute;\n  bottom: 70px;\n  left: 42%;\n  box-shadow: 0 10px 28px #00000061;\n}\n\n.objective {\n  color: var(--text-mut);\n  letter-spacing: .08em;\n  font-size: 10px;\n  position: absolute;\n  top: 52%;\n  right: 20px;\n}\n\n.batch1-preview .objective {\n  text-align: center;\n  max-width: 72%;\n  line-height: 1.35;\n}\n\n.preview-hud {\n  z-index: 1;\n  grid-template-columns: 26px 1fr;\n  align-items: center;\n  gap: 5px 8px;\n  display: grid;\n  position: absolute;\n  top: 14px;\n  left: 14px;\n}\n\n.preview-hud span {\n  background: #030711bf;\n  border: 1px solid #9acdff3d;\n  border-radius: 6px;\n  place-items: center;\n  width: 26px;\n  height: 26px;\n  display: grid;\n}\n\n.preview-hud i {\n  background: linear-gradient(90deg, #ef4444 68%, #ffffff29 0);\n  border-radius: 6px;\n  width: 116px;\n  height: 8px;\n}\n\n.preview-hud i:last-child {\n  background: linear-gradient(90deg, #14d8c8 54%, #ffffff29 0);\n  grid-column: 2;\n}\n\n.asset-strip {\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: 8px;\n  margin: 0 12px 12px;\n  display: grid;\n}\n\n.asset-strip span {\n  min-height: 56px;\n  color: var(--text-mut);\n  background: linear-gradient(145deg, #101a31eb, #040810f5);\n  border: 1px solid #9acdff29;\n  border-radius: 8px;\n  place-items: end center;\n  padding: 8px 6px;\n  font-size: 11px;\n  display: grid;\n}\n\n.wb-bottom-grid {\n  grid-template-columns: 1fr 1fr 1.4fr 320px;\n  gap: 12px;\n  display: grid;\n}\n\n.wb-bottom-grid.with-budget {\n  grid-template-columns: 1fr 1fr 1.2fr 280px 260px;\n}\n\n.prompt-box {\n  border: 1px solid var(--border);\n  min-height: 94px;\n  color: var(--text-pri);\n  background: #00000029;\n  border-radius: 8px;\n  padding: 12px;\n  line-height: 1.55;\n}\n\n.prompt-row {\n  border: 1px solid var(--border);\n  min-height: 38px;\n  color: var(--text-dim);\n  border-radius: 8px;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  padding-left: 12px;\n  font-size: 12px;\n  display: flex;\n}\n\n.agent-now {\n  align-items: center;\n  gap: 10px;\n  display: flex;\n}\n\n.agent-now p {\n  color: var(--text-mut);\n  margin-top: 2px;\n  font-size: 12px;\n}\n\n.agent-glyph {\n  width: 34px;\n  height: 34px;\n  color: var(--cyan);\n  background: #00e5ff14;\n  border: 1px solid #00e5ff3d;\n  border-radius: 9px;\n  place-items: center;\n  display: grid;\n}\n\n.terminal-feed {\n  font-family: var(--font-mono);\n  padding: 12px 14px;\n  font-size: 12px;\n}\n\n.terminal-row {\n  border-bottom: 1px solid #367ecd24;\n  grid-template-columns: 52px 1fr 44px 70px;\n  gap: 10px;\n  padding: 5px 0;\n  display: grid;\n}\n\n.terminal-row:last-child {\n  border-bottom: none;\n}\n\n.terminal-row .kind {\n  color: var(--magenta);\n}\n\n.terminal-row .plus {\n  color: var(--green);\n  text-align: right;\n}\n\n.mini-cortex-panel {\n  grid-template-columns: 112px 1fr;\n  align-items: center;\n  gap: 12px;\n  padding: 12px;\n  display: grid;\n}\n\n.mini-cortex-panel > div:first-child {\n  height: 90px;\n}\n\n.mini-cortex-panel p {\n  color: var(--text-mut);\n  margin-top: 8px;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.wb-layer-board {\n  border: 1px solid var(--studio-border);\n  background: linear-gradient(#081121db, #030810f0);\n  border-radius: 12px;\n  padding: 12px;\n}\n\n.wb-board-head {\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  margin-bottom: 10px;\n  display: flex;\n}\n\n.workspace-mini-grid {\n  grid-template-columns: repeat(11, minmax(0, 1fr));\n  gap: 6px;\n  display: grid;\n}\n\n.workspace-tile {\n  min-height: 68px;\n  color: var(--text-pri);\n  background: #ffffff05;\n  border: 1px solid #367ecd3d;\n  border-radius: 8px;\n  flex-direction: column;\n  gap: 4px;\n  padding: 8px;\n  font-size: 11px;\n  display: flex;\n}\n\n.workspace-tile:hover {\n  background: #00e5ff0a;\n  border-color: #00e5ff52;\n}\n\n.workspace-no {\n  font-family: var(--font-mono);\n  color: var(--text-mut);\n  font-size: 10px;\n}\n\n.workspace-tile small {\n  font-family: var(--font-mono);\n  margin-top: auto;\n  font-size: 10px;\n}\n\n.frames {\n  grid-template-columns: repeat(4, 1fr);\n  gap: 14px;\n  display: grid;\n}\n\n.frame {\n  border: 1px solid var(--border);\n  border-radius: var(--r14);\n  background: var(--surface-1);\n  overflow: hidden;\n}\n\n.frame-bar {\n  color: var(--text-mut);\n  border-bottom: 1px solid var(--border);\n  padding: 8px 12px;\n  font-size: 12px;\n}\n\n.frame-body {\n  height: 170px;\n  color: var(--text-dim);\n  background: #04060c;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  gap: 10px;\n  padding: 12px;\n  font-size: 11px;\n  display: flex;\n}\n\n.frame-skeleton {\n  gap: 4px;\n  width: 84%;\n  height: 88px;\n  display: grid;\n}\n\n.fr-desktop .frame-skeleton {\n  grid-template-columns: 16px 1fr 30%;\n}\n\n.fr-laptop .frame-skeleton {\n  grid-template-columns: 14px 1fr 22%;\n}\n\n.fr-tablet .frame-skeleton {\n  grid-template-columns: 12px 1fr;\n}\n\n.fr-mobile .frame-skeleton {\n  grid-template-columns: 1fr;\n}\n\n.frame-skeleton span {\n  background: #00e5ff1f;\n  border: 1px solid #00e5ff38;\n  border-radius: 4px;\n}\n\n.fs-rail {\n  background: #8b5cf62e;\n  border-color: #8b5cf64d;\n}\n\n.fs-aside {\n  background: #ec489924;\n  border-color: #ec489947;\n}\n\n.fr-tablet .fs-aside, .fr-mobile .fs-aside, .fr-mobile .fs-rail {\n  display: none;\n}\n\n.frame-note {\n  color: var(--text-mut);\n  text-align: center;\n  font-size: 11px;\n}\n\n.oss-table, .bp-table {\n  flex-direction: column;\n  display: flex;\n}\n\n.oss-row {\n  border-bottom: 1px solid var(--border);\n  grid-template-columns: 1.1fr .9fr 2fr;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 12px;\n  font-size: 13px;\n  display: grid;\n}\n\n.bp-row {\n  border-bottom: 1px solid var(--border);\n  grid-template-columns: 1fr 1fr 1fr 1.4fr;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 12px;\n  font-size: 13px;\n  display: grid;\n}\n\n.oss-row:last-child, .bp-row:last-child {\n  border-bottom: none;\n}\n\n.oss-head, .bp-head {\n  text-transform: uppercase;\n  letter-spacing: .05em;\n  color: var(--text-dim);\n  background: var(--surface-2);\n  font-size: 10.5px;\n}\n\n.rule-list {\n  color: var(--text-mut);\n  margin: 0;\n  padding-left: 18px;\n  font-size: 13px;\n  line-height: 1.85;\n}\n\n.rule-list li {\n  margin-bottom: 3px;\n}\n\n.sr-only {\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  position: absolute;\n  overflow: hidden;\n}\n\n.or-divider {\n  color: var(--text-dim);\n  align-items: center;\n  gap: 12px;\n  font-size: 12px;\n  display: flex;\n}\n\n.or-divider:before, .or-divider:after {\n  content: \"\";\n  background: var(--border);\n  flex: 1;\n  height: 1px;\n}\n\n.layerbar {\n  border: 1px solid var(--border);\n  border-radius: var(--r14);\n  background: var(--surface-1);\n  margin-bottom: 16px;\n  padding: 12px 14px;\n}\n\n.layerbar-head {\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  margin-bottom: 10px;\n  display: flex;\n}\n\n.layerbar-title {\n  letter-spacing: .03em;\n  color: var(--text-mut);\n  text-transform: uppercase;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.layerbar-row {\n  grid-template-columns: repeat(7, 1fr);\n  gap: 8px;\n  display: grid;\n}\n\n.layerbar-cell {\n  border: 1px solid var(--border);\n  background: var(--surface-2);\n  opacity: .55;\n  border-radius: 8px;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 8px;\n  display: flex;\n}\n\n.layerbar-cell.on {\n  opacity: 1;\n  border-color: #10b98166;\n}\n\n.layerbar-tag {\n  color: #04060d;\n  border-radius: 5px;\n  padding: 1px 5px;\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.layerbar-code {\n  color: var(--text-pri);\n  font-size: 11px;\n  font-family: var(--mono, monospace);\n}\n\n.layerbar-dot {\n  border-radius: 999px;\n  width: 7px;\n  height: 7px;\n  margin-left: auto;\n}\n\n.layerbar-dot.ok {\n  background: #34d399;\n  box-shadow: 0 0 7px #34d399e6;\n}\n\n.layerbar-dot.spec {\n  background: var(--amber);\n}\n\n@media (max-width: 900px) {\n  .layerbar-row {\n    grid-template-columns: repeat(4, 1fr);\n  }\n\n  .layerbar-code {\n    display: none;\n  }\n}\n\n.roster {\n  flex-direction: column;\n  display: flex;\n}\n\n.roster-row {\n  border-bottom: 1px solid var(--border);\n  grid-template-columns: 14px 1.2fr auto 1.6fr auto;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px;\n  font-size: 13px;\n  display: grid;\n}\n\n.roster-row:last-child {\n  border-bottom: none;\n}\n\n.roster-name {\n  color: var(--text-pri);\n  font-weight: 600;\n}\n\n.roster-model {\n  color: var(--text-dim);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 11.5px;\n  overflow: hidden;\n}\n\n.roster-sess {\n  color: var(--text-mut);\n  text-align: right;\n  min-width: 48px;\n  font-size: 11px;\n}\n\n.readiness {\n  grid-template-columns: repeat(2, 1fr);\n  gap: 2px 18px;\n  display: grid;\n}\n\n.rd-row {\n  border-bottom: 1px solid var(--border);\n  grid-template-columns: 14px 1.3fr auto auto;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px;\n  font-size: 13px;\n  display: grid;\n}\n\n.rd-name {\n  color: var(--text-pri);\n  font-weight: 600;\n}\n\n.rd-layers {\n  color: var(--text-dim);\n  font-size: 10.5px;\n}\n\n@media (max-width: 900px) {\n  .readiness {\n    grid-template-columns: 1fr;\n  }\n}\n\n.ev-grid {\n  flex-direction: column;\n  gap: 2px;\n  display: flex;\n}\n\n.ev-row {\n  border-bottom: 1px solid var(--border);\n  grid-template-columns: 14px 1fr auto;\n  align-items: center;\n  gap: 9px;\n  padding: 6px 4px;\n  font-size: 12.5px;\n  display: grid;\n}\n\n.ev-row:last-child {\n  border-bottom: none;\n}\n\n.ev-row .mono {\n  color: var(--text-mut);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  overflow: hidden;\n}\n\n.swatches {\n  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));\n  gap: 10px;\n  display: grid;\n}\n\n.sw {\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n.sw .chip-color {\n  height: 56px;\n}\n\n.sw .sw-meta {\n  padding: 8px 10px;\n  font-size: 11px;\n}\n\n.sw .sw-meta b {\n  color: var(--text-pri);\n  font-size: 12px;\n  display: block;\n}\n\n.sw .sw-meta span {\n  color: var(--text-mut);\n  font-family: var(--font-mono);\n}\n\n.assets {\n  flex-wrap: wrap;\n  gap: 10px;\n  display: flex;\n}\n\n.asset {\n  text-align: center;\n  width: 64px;\n}\n\n.asset .thumb {\n  border: 1px solid var(--border);\n  width: 64px;\n  height: 48px;\n  color: var(--text-mut);\n  background: var(--surface-2);\n  border-radius: 8px;\n  place-items: center;\n  font-size: 9px;\n  display: grid;\n}\n\n.asset .nm {\n  color: var(--text-mut);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  margin-top: 4px;\n  font-size: 9px;\n  overflow: hidden;\n}\n\n.card-grid {\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: 14px;\n  display: grid;\n}\n\n.gcard {\n  border: 1px solid var(--border);\n  border-radius: var(--r14);\n  background: var(--surface-1);\n  flex-direction: column;\n  display: flex;\n  overflow: hidden;\n}\n\n.gcard .preview {\n  background: linear-gradient(135deg, var(--surface-2), #04060c);\n  height: 120px;\n  color: var(--text-dim);\n  place-items: center;\n  font-size: 11px;\n  display: grid;\n}\n\n.gcard .body {\n  flex-direction: column;\n  flex: 1;\n  gap: 8px;\n  padding: 14px;\n  display: flex;\n}\n\n.gcard h3 {\n  font-size: 14px;\n}\n\n.gcard .sub {\n  color: var(--text-mut);\n  font-size: 12px;\n}\n\n.gcard .actions {\n  gap: 8px;\n  margin-top: auto;\n  display: flex;\n}\n\n.local-search-row {\n  gap: 8px;\n}\n\n.local-search-input {\n  background: var(--surface-2);\n  border: 1px solid var(--border);\n  border-radius: 9px;\n  flex: 1;\n  min-width: 0;\n  padding: 8px 12px;\n  font-size: 13px;\n}\n\n.local-search-input:disabled {\n  color: var(--text-dim);\n  -webkit-text-fill-color: var(--text-dim);\n  opacity: 1;\n}\n\n.goalb-action-panel {\n  gap: 9px;\n  min-width: 0;\n  display: grid;\n}\n\n.goalb-row {\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  display: flex;\n}\n\n.goalb-row input, .goalb-row select {\n  flex: 180px;\n  min-width: 160px;\n  min-height: 32px;\n}\n\n.goalb-row .btn {\n  flex: none;\n}\n\n.goalb-result {\n  white-space: pre-wrap;\n  word-break: break-word;\n  border: 1px solid var(--border);\n  min-height: 74px;\n  max-height: 220px;\n  color: var(--text-mut);\n  background: #05070d8a;\n  border-radius: 8px;\n  margin: 0;\n  padding: 10px;\n  font-size: 11.5px;\n  line-height: 1.45;\n  overflow: auto;\n}\n\n.goalb-artifacts {\n  gap: 6px;\n  display: grid;\n}\n\n.goalb-artifact-row {\n  border: 1px solid var(--border);\n  background: #101a316b;\n  border-radius: 8px;\n  grid-template-columns: auto minmax(90px, auto) minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 8px;\n  padding: 7px 9px;\n  font-size: 12px;\n  display: grid;\n}\n\n.note {\n  border: 1px solid var(--border);\n  border-left: 3px solid var(--cyan);\n  color: var(--text-mut);\n  background: #00e5ff0a;\n  border-radius: 10px;\n  padding: 12px 14px;\n  font-size: 13px;\n}\n\n.note.warn {\n  border-left-color: var(--amber);\n  background: #f59e0b0d;\n}\n\n.note.blocked {\n  border-left-color: var(--red);\n  background: #ef44440d;\n}\n\n.prose {\n  max-width: 72ch;\n}\n\n.prose p {\n  color: var(--text-mut);\n  margin-bottom: 14px;\n  font-size: 14px;\n  line-height: 1.7;\n}\n\n.prose h2 {\n  margin: 24px 0 10px;\n  font-size: 18px;\n}\n\n.prose ul {\n  color: var(--text-mut);\n  padding-left: 20px;\n  font-size: 14px;\n  line-height: 1.7;\n}\n\n@media (max-width: 1280px) {\n  .wb {\n    grid-template-columns: var(--sidebar-w) 1fr;\n  }\n\n  .wb .inspector {\n    display: none;\n  }\n\n  .wb-studio {\n    grid-template-columns: 230px 1fr;\n  }\n\n  .wb-preview {\n    grid-column: 1 / -1;\n  }\n\n  .wb-bottom-grid, .wb-bottom-grid.with-budget {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .workspace-mini-grid {\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n  }\n\n  .hero {\n    grid-template-columns: 1fr;\n  }\n\n  .hero-canvas {\n    max-width: 420px;\n  }\n\n  .home-hero-shell {\n    grid-template-columns: 1fr;\n  }\n\n  .home-cortex-card {\n    min-height: 320px;\n  }\n\n  .home-cortex-card .cortex-wrap, .home-cortex-canvas {\n    height: 288px;\n    min-height: 288px;\n  }\n\n  .cols-4, .feature-grid, .hero-stats {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .grid[style*=\"grid-template-columns\"] {\n    grid-template-columns: 1fr !important;\n  }\n}\n\n@media (max-width: 900px) {\n  .app-shell {\n    grid-template-columns: 1fr;\n    grid-template-areas: \"topbar\"\n                         \"main\";\n  }\n\n  .rail {\n    display: none;\n  }\n\n  .industrial-toolbar {\n    flex-wrap: wrap;\n  }\n\n  .tool-env {\n    margin-left: 0;\n  }\n\n  .tool-select:first-child {\n    flex: 220px;\n    min-width: 0;\n  }\n\n  .wb-studio, .wb-bottom-grid, .wb-bottom-grid.with-budget {\n    grid-template-columns: 1fr;\n  }\n\n  .workspace-mini-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n