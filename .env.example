COMPOSE_PROJECT_NAME=cloud-superbrain-phase1

NGINX_HTTP_PORT=8081
GHCR_IMAGE_NAMESPACE=ghcr.io/strazzusochr/cloud-superbrain-developer-platform
IMAGE_TAG=staging

POSTGRES_USER=superbrain
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=superbrain_prod
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=change-me-too

REDIS_MAXMEMORY=256mb

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_URL=https://langfuse.example.invalid
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

GITHUB_TOKEN=
GITHUB_REPOSITORY=
E2B_API_KEY=

CLOUD_PROVIDER_INVENTORY_ENABLED=true

# External proof gates and cloud providers. Keep real values in local env or
# secret stores only; do not commit provider tokens.
STAGING_BASE_URL=
BRANCH_PROTECTION_TOKEN=

VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
AGENT_API_BASE_URL=
MCP_GATEWAY_BASE_URL=
LLM_GATEWAY_BASE_URL=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STATEFUL_BASE_URL=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_DASHBOARD_URL=

GHCR_TOKEN=
GHCR_OWNER=
GHCR_PACKAGE=
HF_TOKEN=
HF_PROFILE_URL=
GITLAB_TOKEN=
GITLAB_PROFILE_URL=
GITLAB_API_URL=
GRAFANA_CLOUD_API_KEY=
GRAFANA_CLOUD_URL=

LLM_GATEWAY_MODE=deterministic_dry_run
LLM_GATEWAY_URL=http://llm-gateway:4000

WORKING_MEMORY_TTL_SECONDS=1800
MEMORY_CONSOLIDATION_INTERVAL_SECONDS=300
MEMORY_CONSOLIDATION_TTL_THRESHOLD_SECONDS=480
