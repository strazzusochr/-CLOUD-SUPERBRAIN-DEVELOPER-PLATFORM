{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/llm/:path*",
      "destination": "/api/llm"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api/mcp"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 60
    }
  }
}
