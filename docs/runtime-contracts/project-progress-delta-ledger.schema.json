{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-superbrain.local/schemas/project-progress-delta-ledger-v2.json",
  "title": "Project progress source-bound delta ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_version",
    "baseline",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "../runtime-contracts/project-progress-delta-ledger.schema.json"
    },
    "contract_version": {
      "const": "project-progress-delta-ledger-v2"
    },
    "baseline": {
      "const": {
        "source_sha": "9a3776fffd226271fcd3d01fdefb0405e5303ce0",
        "projection_sha256": "de6c3568a200c34daac1755c25a24b51d0c792d0752e2f952e58610f3a3dee7a",
        "overall_percent": 89,
        "cells": [
          {
            "scope": "horizontal",
            "id": "phase_0",
            "label": "Phase 0 - Reboot & Goal Lock",
            "percent": 100
          },
          {
            "scope": "horizontal",
            "id": "phase_1",
            "label": "Phase 1 - Foundation Runtime",
            "percent": 100
          },
          {
            "scope": "horizontal",
            "id": "phase_2",
            "label": "Phase 2 - Core Runtime",
            "percent": 100
          },
          {
            "scope": "horizontal",
            "id": "phase_3",
            "label": "Phase 3 - Product Surface & Security",
            "percent": 44
          },
          {
            "scope": "horizontal",
            "id": "phase_4",
            "label": "Phase 4 - Integration & Hardening",
            "percent": 100
          },
          {
            "scope": "horizontal",
            "id": "phase_5",
            "label": "Phase 5 - Release Readiness",
            "percent": 89
          },
          {
            "scope": "horizontal",
            "id": "phase_6",
            "label": "Phase 6 - Scale & 3D Platform",
            "percent": 90
          },
          {
            "scope": "vertical",
            "id": "layer_1",
            "label": "Frontend / Next.js",
            "percent": 100
          },
          {
            "scope": "vertical",
            "id": "layer_2",
            "label": "Orchestrator / LangGraph",
            "percent": 100
          },
          {
            "scope": "vertical",
            "id": "layer_3",
            "label": "Agent Pool",
            "percent": 100
          },
          {
            "scope": "vertical",
            "id": "layer_4",
            "label": "LLM Gateway",
            "percent": 55
          },
          {
            "scope": "vertical",
            "id": "layer_5",
            "label": "MCP Gateway",
            "percent": 56
          },
          {
            "scope": "vertical",
            "id": "layer_6",
            "label": "Memory",
            "percent": 100
          },
          {
            "scope": "vertical",
            "id": "layer_7",
            "label": "Observability",
            "percent": 100
          }
        ]
      }
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "scope",
          "cell_id",
          "old_percent",
          "new_percent",
          "overall_percent",
          "previous_projection_sha256",
          "projection_sha256",
          "source_sha",
          "verifier_command",
          "artifact_path",
          "artifact_sha256"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "scope": {
            "enum": [
              "horizontal",
              "vertical"
            ]
          },
          "cell_id": {
            "enum": [
              "phase_0",
              "phase_1",
              "phase_2",
              "phase_3",
              "phase_4",
              "phase_5",
              "phase_6",
              "layer_1",
              "layer_2",
              "layer_3",
              "layer_4",
              "layer_5",
              "layer_6",
              "layer_7"
            ]
          },
          "old_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "new_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "overall_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "previous_projection_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "projection_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "verifier_command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\r\\n]).*\\S$",
            "description": "Structural audit field only; authoritative replay accepts and executes only a statically approved scorer."
          },
          "artifact_path": {
            "type": "string",
            "pattern": "^(?:\\.phase1-artifacts|docs/release-artifacts)/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9._/-]+$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
